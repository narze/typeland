{
  "name": "typeland",
  "author": "@narze",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit && tsc --pretty --noEmit -p cypress",
    "format": "prettier --write \"**/*.{js,ts,tsx}\"",
    "lint": "eslint .",
    "test": "jest",
    "test-all": "yarn lint && yarn type-check && yarn test --ci --coverage && yarn cy:ci",
    "cy:run": "cypress run --browser chrome",
    "cy:run:headless": "cypress run --browser chrome --headless",
    "cy:open": "cypress open",
    "e2e": "start-test dev 3000 cy:open",
    "cy:ci": "start-test start 3000 cy:run:headless",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "yarn lint",
      "yarn format"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@chakra-ui/react": "^3",
    "@emotion/react": "^11",
    "firebase": "^12",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "use-reducer-async": "^2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@storybook/addon-links": "^10.5.0",
    "@storybook/nextjs": "^10.5.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/cypress": "^10",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/jest": "^30",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^15",
    "dotenv-flow": "^4",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "eslint-config-prettier": "^10",
    "eslint-plugin-cypress": "^5",
    "husky": "^9",
    "jest": "^30",
    "jest-environment-jsdom": "^30",
    "jest-watch-typeahead": "^3",
    "lint-staged": "^17",
    "postcss": "^8",
    "prettier": "^3",
    "start-server-and-test": "^3",
    "storybook": "^10.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
