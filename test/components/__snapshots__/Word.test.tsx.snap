// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`renders single word with caret 1`] = `
<DocumentFragment>
  <span
    class="relative mr-1"
    data-testid="word"
  >
    <span
      class="text-green-600 correct"
      data-testid="correct"
    >
      d
    </span>
    <span
      class="text-green-600 correct"
      data-testid="correct"
    >
      o
    </span>
    <span
      class="text-gray-300 pending"
      data-testid="pending"
    >
      g
    </span>
    <span
      class="text-gray-300 pending"
      data-testid="pending"
    >
      e
    </span>
    <span
      class="absolute h-6 w-0.5 bg-blue-500 transition-all duration-100 ease-out"
      data-testid="caret"
      style="left: 1px; top: 4px;"
    />
  </span>
</DocumentFragment>
`;

